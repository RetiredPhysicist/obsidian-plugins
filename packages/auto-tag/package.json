{
  "name": "obsidian-systemone-auto-tag",
  "version": "0.1.0",
  "description": "Kaku-style probabilistic auto tagging for Obsidian via System One (Noul)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "smoke": "node scripts/smoke-systemone.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "tags",
    "systemone",
    "jev"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
